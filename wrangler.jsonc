{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "run-weather",
  "compatibility_date": "2026-06-01",
  // Static assets only — the app talks to Open-Meteo directly from the browser.
  "assets": {
    "directory": "./dist",
  },
  // Explicitly empty so deploying removes the old Supabase keep-alive cron.
  "triggers": {
    "crons": [],
  },
}
